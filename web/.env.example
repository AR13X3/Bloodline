# Copy this file to .env.local and fill in your own values.
# .env.local is git-ignored. Never commit real keys.
# Any channel whose keys are blank is logged as "simulated" instead of sent.

# OCR of report PDFs (OpenRouter)
OPENROUTER_API_KEY=
# Optional. Leave blank to use the default.
OPENROUTER_MODEL=

# Email (Resend). onboarding@resend.dev only delivers to your Resend account's own email.
RESEND_API_KEY=
EMAIL_FROM=BloodLine <onboarding@resend.dev>

# SMS and voice calls (Twilio). Numbers in international format, e.g. +61...
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Demo GP contact details (used when the demo database is seeded or reset).
# Email must be your Resend account's own address. Mobile in international format.
DEMO_GP_EMAIL=
DEMO_GP_MOBILE=

# Optional pre-recorded voice message (public MP3/WAV URL, e.g. from Twilio Assets).
# If blank, calls use a computer voice instead.
VOICE_MESSAGE_URL=
